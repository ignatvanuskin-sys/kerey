{
  "name": "kerey-autoservice",
  "version": "1.0.0",
  "private": true,
  "description": "Керей — автокомплекс в Кокшетау. Продающий сайт с онлайн-записью и панелью заявок.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/run-smoke.ps1",
    "lighthouse": "powershell -ExecutionPolicy Bypass -File scripts/run-lighthouse.ps1",
    "make-images": "powershell -ExecutionPolicy Bypass -File scripts/make-images.ps1",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1",
    "reset": "tsx scripts/reset.ts",
    "env:init": "node scripts/init-env.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
