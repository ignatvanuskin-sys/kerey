# ---------------------------------------------------------------------------
# Керей — автокомплекс. Пример переменных окружения.
# Скопируйте в .env и заполните. В репозиторий .env не попадает.
# ---------------------------------------------------------------------------

# Публичный адрес сайта без слэша на конце (Open Graph, sitemap).
# На Vercel можно не задавать: адрес подставится автоматически.
PUBLIC_BASE_URL=http://localhost:3000

# Пароль для входа в панель заявок /admin.
ADMIN_PASSWORD=
# 32+ случайных символа — подпись cookie сессии.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# ХРАНИЛИЩЕ ЗАЯВОК
#
# Локально и на обычном сервере ничего указывать не нужно:
# заявки пишутся в файл data/bookings.json.
#
# На Vercel (и любом serverless-хостинге) файлы не сохраняются, поэтому нужна база.
# Самый простой вариант — Redis из Vercel Storage (Upstash). После подключения
# Vercel сам добавит эти переменные, вручную их задавать не нужно:
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# ОПЦИОНАЛЬНО: уведомления о новых заявках в Telegram.
# Пока переменные пустые — заявки сохраняются только в панели /admin.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
