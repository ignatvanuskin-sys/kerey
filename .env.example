# ---------------------------------------------------------------------------
# Керей — автокомплекс. Пример переменных окружения (§13 мастер-промпта).
# Скопируйте в .env и заполните. Значения секретов в репозиторий не попадают.
# ---------------------------------------------------------------------------

# База данных. По умолчанию — файл SQLite (см. README → «Допущения»).
DATABASE_URL=file:./data/kerey.db

# Публичный адрес сайта без завершающего слэша (нужен для вебхука Telegram и ссылок).
PUBLIC_BASE_URL=https://example.com

# --- Telegram -------------------------------------------------------------
# Токен бота, созданного владельцем через @BotFather.
TELEGRAM_BOT_TOKEN=
# Получатели карточек через запятую: личный chat_id владельца и/или группа.
TELEGRAM_CHAT_IDS=
# Случайная строка 32+ символов — защита вебхука.
TELEGRAM_WEBHOOK_SECRET=
# true — сайт обрабатывает кнопки ✅/❌ сам (нужен setWebhook).
# false — у бота владельца уже есть свой webhook/polling: сайт только отправляет карточки.
TELEGRAM_CALLBACKS_ENABLED=true
# Опционально: username бота без @ (для кнопки «Получать статус в Telegram»).
TELEGRAM_BOT_USERNAME=

# --- Админка --------------------------------------------------------------
ADMIN_PASSWORD=
# 32+ случайных символов — подпись cookie сессии администратора.
SESSION_SECRET=
# Секрет для вызова /api/cron/notify планировщиком.
CRON_SECRET=

# --- Антиспам (опционально) -----------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Аналитика (опционально, по умолчанию выключена) ----------------------
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
